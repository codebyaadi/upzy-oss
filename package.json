{
  "name": "upzy",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.3.6"
    },
    "catalogs": {
      "dev": {
        "typescript": "5.9.2",
        "@types/node": "^22.15.3",
        "@types/bun": "latest",
        "oxlint": "^1.48.0"
      },
      "ui": {
        "@tailwindcss/postcss": "^4",
        "tailwindcss": "^4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "@hugeicons/core-free-icons": "^4.3.5",
        "@hugeicons/react": "^1.1.5"
      }
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "turbo run check-types",
    "db:generate": "bun run --filter @upzy/db drizzle:generate",
    "db:migrate": "bun run --filter @upzy/db drizzle:migrate",
    "test": "turbo run test"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "turbo": "^2.8.13",
    "typescript": "5.9.2"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "tinypool": "^2.2.0"
  },
  "packageManager": "bun@1.4.2"
}
