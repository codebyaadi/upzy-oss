{
  "$id": "agent-job.schema.json",
  "title": "AgentJob",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "monitorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "type": {
      "type": "string",
      "enum": [
        "http",
        "tcp",
        "dns",
        "ssl",
        "flow"
      ]
    },
    "target": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "sealedSecrets": {
      "type": "object",
      "properties": {
        "epk": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{16}$"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 24
        }
      },
      "required": [
        "epk",
        "nonce",
        "ciphertext"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "jobId",
    "monitorId",
    "type",
    "target",
    "config"
  ],
  "additionalProperties": false
}
