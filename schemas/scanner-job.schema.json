{
  "$id": "scanner-job.schema.json",
  "title": "ScannerJob",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "assetId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "host": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "rateLimitPerSecond": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    }
  },
  "required": [
    "jobId",
    "assetId",
    "host",
    "url",
    "rateLimitPerSecond",
    "timeoutSeconds"
  ],
  "additionalProperties": false
}
