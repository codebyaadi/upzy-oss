# Copy to .env at the repo root. The API, worker, DB scripts and Next.js all read this one file.

# --- Database (docker/docker-compose.postgres.yml) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/upzy

# --- API (apps/api) ---
PORT=3000
# Secret for signing sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Where the web app runs: used for CORS and better-auth trusted origins
WEB_ORIGIN=http://localhost:3001
# Encrypts notification-channel secrets at rest (32 bytes, base64): openssl rand -base64 32
UPZY_ENCRYPTION_KEY=

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For. Otherwise rate limits and the audit
# log use the socket address, and a client-supplied header cannot spoof them.
TRUST_PROXY=false

# Who may create an account: open (anyone), invite (first account, allow-listed emails/domains, people holding an
# organization invitation) or closed. Open is the development default; deploy/compose.yml defaults to invite.
SIGNUP_MODE=open
SIGNUP_ALLOWED_EMAILS=
SIGNUP_ALLOWED_DOMAINS=

# Optional "Continue with GitHub". Create an OAuth app at github.com/settings/developers with the callback URL
# <BETTER_AUTH_URL>/api/auth/callback/github (http://localhost:3000/api/auth/callback/github locally).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Worker (apps/worker) ---
# scheduler: queues due checks | prober: runs monitor checks | notifier: sends alerts
# scanner: security scans + weekly subdomain discovery | agent: AI jobs | correlator: groups related incidents
WORKER_ROLES=scheduler,prober,notifier,scanner,agent,correlator
# How long monitor checks (default 90, minimum 35, or "off") and finished jobs are kept. Runs with the scheduler role.
CHECK_RETENTION_DAYS=90
JOB_RETENTION_DAYS=14
FAILED_JOB_RETENTION_DAYS=30
# Base URL used in links inside alert messages
APP_URL=http://localhost:3001
# Mailpit from docker/docker-compose.mail.yml. Leave empty to disable email delivery.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Upzy <alerts@upzy.local>"
# --- AI ---
# Upzy has no AI provider key of its own. Each organization connects its own key (Groq, OpenAI, Anthropic, Gemini,
# OpenRouter) in Settings -> AI; keys are encrypted with UPZY_ENCRYPTION_KEY. These are only limits:
# requests per minute across this process, and the default daily token budget per organization.
AI_RPM_LIMIT=60
AI_ORG_DAILY_TOKEN_BUDGET=200000

# Optional: raises the NVD rate limit (5 -> 50 requests / 30s) for CVE lookups.
# Free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Billing (Dodo Payments): leave empty locally to run without plans or limits. See docs/BILLING.md.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_MODE=test
