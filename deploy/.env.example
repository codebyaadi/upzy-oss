# Copy to deploy/.env on the server (chmod 600). Compose reads it for every ${...} in compose.yml.

# --- Where it lives ---
# Two sibling hostnames under one domain, both pointing (A/AAAA) at the server.
DOMAIN_APP=app.example.com
DOMAIN_API=api.example.com
# Shared by both so the session cookie works across them. Note the leading dot.
COOKIE_DOMAIN=.example.com
# Let's Encrypt registration / expiry notices.
ACME_EMAIL=you@example.com

# --- Images (built and pushed by .github/workflows/deploy.yml) ---
# ghcr.io/<this value>-server and ghcr.io/<this value>-web, lowercase: owner/repo
UPZY_IMAGE_REPO=your-github-user/upzy
IMAGE_TAG=latest

# --- Secrets: generate each one, never reuse ---
POSTGRES_PASSWORD=            # openssl rand -hex 24
BETTER_AUTH_SECRET=           # openssl rand -base64 32
UPZY_ENCRYPTION_KEY=          # openssl rand -base64 32  (encrypts channel secrets AND customers' AI keys; back it up!)

# --- Billing with Dodo Payments (optional) ---
# Leave DODO_API_KEY and DODO_WEBHOOK_SECRET empty to run without plans: nothing is limited. To sell plans, follow
# docs/BILLING.md. Use DODO_MODE=test until you have tried a purchase end to end.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_MODE=test
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_AGENCY_MONTHLY=
DODO_PRODUCT_AGENCY_YEARLY=

# --- Legal pages (Terms, Privacy, Acceptable Use) ---
# Who they speak for and where people can write. Use your legal name or company; without CONTACT_EMAIL the pages
# point to the GitHub profile. LEGAL_JURISDICTION (e.g. India) adds a governing-law clause when set.
LEGAL_ENTITY=
CONTACT_EMAIL=
LEGAL_JURISDICTION=

# --- Email (alerts, invitations, password resets) ---
# Any SMTP provider: Resend, Brevo, Amazon SES, Postmark... e.g. smtps://user:pass@smtp.resend.com:465
SMTP_URL=
MAIL_FROM="Upzy <alerts@example.com>"

# --- Who may create an account ---
# invite (default): the very first account, allow-listed emails/domains, and people with a pending invitation.
# open: anyone. closed: nobody new. Set SIGNUP_ALLOWED_EMAILS to YOUR email before first start, so nobody else can
# claim a fresh install. Comma-separated lists.
SIGNUP_MODE=invite
SIGNUP_ALLOWED_EMAILS=
SIGNUP_ALLOWED_DOMAINS=

# --- Sign in with GitHub (optional) ---
# OAuth app at github.com/settings/developers; callback URL https://<DOMAIN_API>/api/auth/callback/github.
# Leave empty to hide the button. New accounts still follow SIGNUP_MODE above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional ---
NVD_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
# Limits only: Upzy holds no AI provider keys, each organization adds its own in Settings -> AI.
AI_RPM_LIMIT=60
AI_ORG_DAILY_TOKEN_BUDGET=200000
WORKER_ROLES=scheduler,prober,notifier,scanner,agent,correlator
WORKER_REGION=primary

# --- Data retention (runs inside the scheduler role) ---
# Monitor checks older than this are deleted. At least 35 (the response chart shows 30 days); "off" keeps everything.
# Incidents, findings and status-page uptime are never purged by this.
CHECK_RETENTION_DAYS=90
JOB_RETENTION_DAYS=14
FAILED_JOB_RETENTION_DAYS=30
# Welcome, first-fix and trial-ending emails (need Resend or SMTP). Set to off to send none.
LIFECYCLE_EMAILS=on
# Scheduled client reports (Agency plan). Set to off to send none.
CLIENT_REPORTS=on

# --- AWS only ---
# Where the "offsite" service copies the nightly dumps. Start it with: docker compose --profile aws up -d
BACKUP_S3_URI=
AWS_REGION=ap-south-1
